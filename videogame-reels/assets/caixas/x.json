<style>
  /* inline-flex, not flex: a block-level <li> drops out of the theme's icon row
     onto its own line. Works both when the row is a flex container and when the
     sibling <li>s are inline-block. */
  li.xp-login-item {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li.xp-login-item::before,
  li.xp-login-item::marker {
    content: none;
  }

  .xp-login--header {
    display: inline-flex;
    align-items: center;
    margin-top: 0;
  }

  /* xp_components.css sizes the button as a 44px touch target with a -5px lift, which
     is tuned for in-page placement. In a header icon row that makes it taller and wider
     than the theme's own 24px icons, so it sits high and sits too far from its neighbour. */
  .xp-login--header .xp-login-icon-button {
    margin-top: 0;
    min-width: 0;
    min-height: 0;
    padding: 8px;
  }

  /* Restore the 44px touch target where it actually matters. */
  @media screen and (max-width: 768px) {
    .xp-login--header .xp-login-icon-button {
      min-width: 44px;
      min-height: 44px;
    }
  }

  /* Drawer mount: the button is the first row of Venue's drawer menu <ul>. It needs its
     own sizing/stacking rules distinct from the desktop icon row, a stacking context so
     drawer layers don't swallow clicks, and a full touch target. */
  .xp-login--drawer {
    position: relative;
    z-index: 1;
    display: block;
    align-items: center;
    margin-top: 0;
    pointer-events: auto;
  }

  /* The <li> we add as the first drawer menu row: full-width, icon left, popover below.
     Beats the desktop `li.xp-login-item { display: inline-flex }` by coming later. */
  li.xp-login-item--drawer {
    display: block;
    width: 100%;
    padding: 12px 0;
  }

  .xp-login--drawer .xp-login-popover-trigger,
  .xp-login--drawer .xp-login-icon-button {
    pointer-events: auto;
  }

  .xp-login--drawer .xp-login-icon-button {
    margin-top: 0;
    min-width: 44px;
    min-height: 44px;
    padding: 8px;
  }

  /* Drawer is a transform ancestor, so the JS's position:fixed coords land off-screen; render in-flow instead. */
  .xp-login--drawer .xp-login-popover-trigger {
    display: block;
  }

  .xp-login--drawer .xp-login-popover.open {
    position: static;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    width: auto;
    margin-top: 8px;
  }

  /* Venue styles input/button elements inside its header and drawer, overriding the
     component's own styling once the popover is mounted there (the section block, in the
     page body, is unaffected). Force the intended look back. Scoped to our container
     classes so the section block is never touched. -webkit-text-fill-color is included
     because some themes set it on inputs, and it wins over `color` on WebKit. */
  .xp-login--header .xp-number-input-large,
  .xp-login--drawer .xp-number-input-large {
    color: var(--xp-color-white) !important;
    -webkit-text-fill-color: var(--xp-color-white) !important;
    background: rgba(255, 255, 255, 0.1) !important;
    /* Venue adds a bottom margin to inputs, which inflates the flex row and leaves
       "Use max" (stretched to the row) towering below the input box. */
    margin: 0 !important;
    height: auto !important;
  }

  .xp-login--header .xp-max-btn,
  .xp-login--drawer .xp-max-btn {
    margin: 0 !important;
    height: auto !important;
    border-top-left-radius: 0 !important;
    border-bottom-left-radius: 0 !important;
    border-top-right-radius: 8px !important;
    border-bottom-right-radius: 8px !important;
  }
</style>


